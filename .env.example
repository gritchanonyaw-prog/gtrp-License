# Root .env is NOT read by the Worker. This file documents every setting.
# Worker vars live in apps/api/wrangler.toml ([vars] / [env.*.vars]).
# Worker SECRETS are set with `wrangler secret put <NAME> --env <staging|production>`
# and, for local development, in apps/api/.dev.vars (run: pnpm secrets:dev).

# ---- Worker secrets (never commit real values) ----
LICENSE_KEY_PEPPER=            # 32+ random bytes, base64. Changing it invalidates every license key, device and account hash.
LEASE_SIGNING_PRIVATE_JWK=     # Ed25519 private JWK JSON. Public half is served at /api/v1/lease/public-keys.
LEASE_PREVIOUS_PUBLIC_KEYS=    # optional, JSON [{ "kid": "...", "jwk": { "kty":"OKP","crv":"Ed25519","x":"..." } }] during rotation
MFA_ENCRYPTION_KEY=            # 32 random bytes, base64. AES-GCM key for admin TOTP secrets.
MOCK_PAYMENT_WEBHOOK_SECRET=   # development/staging mock payment provider only

# ---- Worker vars (wrangler.toml) ----
# ENVIRONMENT=development|staging|production
# APP_ORIGINS=comma-separated origins allowed for browser requests (Web App + admin)
# COOKIE_SECURE=true in staging/production
# REQUIRE_ADMIN_MFA=true in staging/production
# PAYMENTS_MOCK_ENABLED=false in production
# LEASE_SIGNING_KEY_ID, LEASE_TTL_SECONDS, REVALIDATE_AFTER_SECONDS, SESSION_TTL_HOURS

# ---- CI / deployment (GitHub Actions secrets) ----
# CLOUDFLARE_API_TOKEN=        # scoped token: Workers Scripts:Edit, D1:Edit
# CLOUDFLARE_ACCOUNT_ID=
