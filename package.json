{
  "name": "gtrp-license",
  "private": true,
  "version": "1.0.0",
  "description": "GTRP Unified License System: one license for the GTRP Web App and MT4/MT5 EAs",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @gtrp/admin build && pnpm --filter @gtrp/api build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev:api": "pnpm --filter @gtrp/api dev",
    "dev:admin": "pnpm --filter @gtrp/admin dev",
    "db:migrate:local": "pnpm --filter @gtrp/api db:migrate:local",
    "secrets:dev": "node scripts/generate-dev-secrets.mjs",
    "db:seed:local": "pnpm --filter @gtrp/api db:seed:local",
    "mock:pay": "node scripts/mock-payment.mjs"
  }
}
